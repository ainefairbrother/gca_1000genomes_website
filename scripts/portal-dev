#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

PORTAL_DIR="${REPO_ROOT}/_data-portal"
BUILD_JS_REL="static/build.js"
BUILD_JS="${PORTAL_DIR}/${BUILD_JS_REL}"
CONTAINER_PATH="/usr/share/nginx/html/data-portal/static/build.js"

DOCKER_CONTEXT="colima-amd64"
FE_CONTAINER="igsr-fe"
POLL_SECONDS=1

log() { printf "\n==> %s\n" "$*"; }
die() { printf "\nERROR: %s\n" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Starts webpack in watch mode for _data-portal and copies static/build.js
into a running frontend container after each rebuild.

Options:
  --context NAME      Docker context (default: ${DOCKER_CONTEXT})
  --container NAME    Frontend container name (default: ${FE_CONTAINER})
  --portal-dir PATH   Portal directory (default: ${PORTAL_DIR})
  --poll-seconds N    Poll interval for build.js changes (default: ${POLL_SECONDS})
  -h, --help          Show this help
EOF
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --context)
        DOCKER_CONTEXT="$2"; shift 2 ;;
      --container)
        FE_CONTAINER="$2"; shift 2 ;;
      --portal-dir)
        PORTAL_DIR="$2"; shift 2 ;;
      --poll-seconds)
        POLL_SECONDS="$2"; shift 2 ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        die "Unknown argument: $1 (use --help)" ;;
    esac
  done
  BUILD_JS="${PORTAL_DIR}/${BUILD_JS_REL}"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

get_mtime() {
  local f="$1"
  if stat -f %m "$f" >/dev/null 2>&1; then
    stat -f %m "$f"
  else
    stat -c %Y "$f"
  fi
}

check_prereqs() {
  need_cmd docker
  need_cmd node

  [ -d "$PORTAL_DIR" ] || die "Portal directory not found: $PORTAL_DIR"
  [ -f "$PORTAL_DIR/webpack.config.js" ] || die "Missing webpack config: $PORTAL_DIR/webpack.config.js"
  [ -x "$PORTAL_DIR/node_modules/webpack/bin/webpack.js" ] || die "Missing webpack binary. Run: (cd $PORTAL_DIR && npm install --unsafe-perm --legacy-peer-deps)"

  if ! docker --context "$DOCKER_CONTEXT" ps --format '{{.Names}}' | grep -qx "$FE_CONTAINER"; then
    die "Container '$FE_CONTAINER' not running in context '$DOCKER_CONTEXT'"
  fi
}

WEBPACK_PID=""
cleanup() {
  if [ -n "$WEBPACK_PID" ] && kill -0 "$WEBPACK_PID" >/dev/null 2>&1; then
    log "Stopping webpack watcher (pid=$WEBPACK_PID)"
    kill "$WEBPACK_PID" >/dev/null 2>&1 || true
    wait "$WEBPACK_PID" >/dev/null 2>&1 || true
  fi
}

main() {
  parse_args "$@"
  check_prereqs

  log "Starting webpack watch in $PORTAL_DIR"
  (
    cd "$PORTAL_DIR"
    exec node node_modules/webpack/bin/webpack.js --watch --config webpack.config.js
  ) &
  WEBPACK_PID="$!"

  trap cleanup EXIT INT TERM

  local last_mtime=""
  while kill -0 "$WEBPACK_PID" >/dev/null 2>&1; do
    if [ -f "$BUILD_JS" ]; then
      local current_mtime
      current_mtime="$(get_mtime "$BUILD_JS")"
      if [ "$current_mtime" != "$last_mtime" ]; then
        docker --context "$DOCKER_CONTEXT" cp "$BUILD_JS" "${FE_CONTAINER}:${CONTAINER_PATH}"
        log "Synced ${BUILD_JS_REL} to ${FE_CONTAINER}"
        last_mtime="$current_mtime"
      fi
    fi
    sleep "$POLL_SECONDS"
  done

  wait "$WEBPACK_PID"
}

main "$@"
